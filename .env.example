# MySQL / MariaDB connection used by Prisma (runtime + CLI)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/myblog"

# Signs admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every admin out.
SESSION_SECRET=""

# Public base URL, used for the sitemap and canonical/Open Graph links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only needed the first time you run `npm run db:seed` (creates the admin account)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Set to 1 only when the app runs behind a reverse proxy (nginx/Apache) that
# sets `X-Real-IP $remote_addr`. Rate limiting then uses that header as the
# client IP. Leave empty when Next.js is exposed directly.
TRUST_PROXY=""
