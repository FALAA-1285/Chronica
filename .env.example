# MySQL / MariaDB connection used by Prisma (runtime + CLI)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/myblog"

# Signs admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every admin out.
SESSION_SECRET=""

# Public base URL, used for the sitemap and canonical/Open Graph links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only needed the first time you run `npm run db:seed` (creates the admin account)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
